  "proposed_mutation_examples": [
    {
      "description": "Set exact progress replaces the released episode set with the selected prefix, filling the gap. It does not mark upcoming E4.",
      "request": {
        "schema_version": 1,
        "operation_id": "sample-fill-gap-001",
        "base_revision": 42,
        "type": "set_exact_progress",
        "show_id": 900001,
        "catalog_revision": "synthetic-catalog-1",
        "target_episode_id": 910003,
        "released_episode_ids": [910001, 910002, 910003],
        "watched_episode_ids": [910001, 910002, 910003],
        "establish_exact_progress": true
      },
      "expected_changed_states": [{ "episode_id": 910002, "watched": true, "revision": 43 }],
      "expected_watched_through_episode_id": 910003
    },
    {
      "description": "Undo restores only the state changed by the bulk command if that state has not changed again.",
      "request": {
        "schema_version": 1,
        "operation_id": "sample-undo-fill-gap-001",
        "base_revision": 43,
        "type": "undo_operation",
        "undo_operation_id": "sample-fill-gap-001"
      },
      "expected_changed_states": [{ "episode_id": 910002, "watched": false, "revision": 44 }],
      "expected_watched_through_episode_id": 910001,
      "expected_furthest_marked_watched_episode_id": 910003
    },
    {
      "description": "Independent example: moving exact progress backwards marks the later released episode unwatched, preserving the distinction between a prefix and a sparse set.",
      "request": {
        "schema_version": 1,
        "operation_id": "sample-set-earlier-progress-001",
        "base_revision": 42,
        "type": "set_exact_progress",
        "show_id": 900001,
        "catalog_revision": "synthetic-catalog-1",
        "target_episode_id": 910001,
        "released_episode_ids": [910001, 910002, 910003],
        "watched_episode_ids": [910001],
        "establish_exact_progress": true
      },
      "expected_changed_states": [{ "episode_id": 910003, "watched": false, "revision": 43 }],
      "expected_watched_through_episode_id": 910001,
      "expected_furthest_marked_watched_episode_id": 910001
    },
    {
      "description": "Independent example: declare Finished without claiming exact episode progress.",
